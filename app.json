{
  "expo": {
    "name": "FoodMood",
    "slug": "foodmood-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/plato-sonriente-tenedor.png",
    "scheme": "foodmood",
    "intentFilters": [
      {
        "action": "VIEW",
        "data": [
          {
            "scheme": "foodmood"
          }
        ],
        "category": ["BROWSABLE", "DEFAULT"]
      }
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rominavilatta.foodmoodapp",
      "infoPlist": {
        "UILaunchStoryboardName": "SplashScreen"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "ic_shortcut_records": "./assets/images/shortcut/shortcut-small.png"
          },
          "iosIcons": {
            "ic_shortcut_records": "./assets/images/shortcut/shortcut-small.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "04528f1e-2cb2-4252-8026-2d79a3c337d0"
      }
    },
    "android": {
      "package": "com.rominavilatta.foodmoodapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/plato-sonriente-tenedor.png",
        "backgroundColor": "#ffffff"
      }
    },
    "owner": "rominavilatta"
  }
}
